# Absolute base URL the deployed site is served from. Used to resolve the
# Open Graph / Twitter card image URLs into absolute URLs (metadataBase).
#
# Read at BUILD time (NEXT_PUBLIC_* values are inlined into the bundle), so it
# must be set in your build environment — for Cloudflare Workers Builds, add it
# under Settings > Build > Variables and secrets.
#
# Leave unset for local development; it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com
